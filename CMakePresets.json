{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release",
            "binaryDir": "${sourceDir}/build/",
            "generator": "Ninja"
        }
